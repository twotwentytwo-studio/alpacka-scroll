{
	"name": "@alpacka/scroll",
	"version": "0.4.0",
	"description": "Smooth wheel over the browser's own scroll, and a virtual scroll for full-WebGL pages, on one rAF clock — named locks, page-transition pin, infinite columns and strips. Ships an agent skill.",
	"keywords": [
		"scroll",
		"smooth-scroll",
		"virtual-scroll",
		"infinite-scroll",
		"wheel",
		"lenis-alternative",
		"page-transition",
		"webgl",
		"raf",
		"dom",
		"agent-skill"
	],
	"license": "MIT",
	"author": "Jesper Landberg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twotwentytwo-studio/alpacka-scroll.git"
	},
	"homepage": "https://github.com/twotwentytwo-studio/alpacka-scroll#readme",
	"bugs": {
		"url": "https://github.com/twotwentytwo-studio/alpacka-scroll/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"skills",
		"playground",
		"AGENTS.md",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"watch": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node playground/run-tests.mjs",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"typescript": "^5"
	},
	"publishConfig": {
		"access": "public"
	}
}
